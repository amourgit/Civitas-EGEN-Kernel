<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>africa.civitas.egen</groupId>
    <artifactId>egen-kernel</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>kernel-bootstrap</artifactId>
  <packaging>jar</packaging>

  <name>EGEN Kernel — Bootstrap (composition finale)</name>
  <description>
    La racine de composition — l'app Quarkus reelle du Kernel. Aucune logique
    metier ici : EgenKernelApplication ne fait que declencher KernelBootSequence et
    journaliser son bilan — voir boot/ et config/.

    Assemble : kernel-sdk, kernel-jpa-support, kernel-plugin-engine,
    plugin-process-grpc-adapter (voir KernelBootConfig#pluginLoader(), qui choisit
    entre Pf4jPluginLoader et RpcPluginLoader selon egen.kernel.plugin-loader), et
    kernel-eventbus (eventbus-api + eventbus-kafka-adapter). N'assemble jamais de
    service ou de module metier : ceux-la restent, par construction, des candidats
    au chargement dynamique via kernel-plugin-engine (mode module) ou des processus
    independants qui s'enregistrent aupres du Kernel (mode service) — jamais des
    dependances Maven de ce module.
  </description>

  <dependencies>
    <dependency>
      <groupId>africa.civitas.egen</groupId>
      <artifactId>kernel-sdk</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>africa.civitas.egen</groupId>
      <artifactId>kernel-jpa-support</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>africa.civitas.egen</groupId>
      <artifactId>kernel-plugin-engine</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!--
      Depuis le 11 septembre 2026 : KernelBootConfig#pluginLoader() choisit
      reellement entre Pf4jPluginLoader et RpcPluginLoader selon
      egen.kernel.plugin-loader (voir ce producteur) — ce module n'est donc plus
      une dependance speculative, contrairement a ce qu'annoncait la Javadoc de ce
      producteur jusqu'a cette date. Apporte transitivement quarkus-jackson (pour
      l'ObjectMapper injecte dans RpcPluginLoader) et les dependances gRPC/Bouncy
      Castle deja documentees dans son propre pom.xml.
    -->
    <dependency>
      <groupId>africa.civitas.egen</groupId>
      <artifactId>plugin-process-grpc-adapter</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>africa.civitas.egen</groupId>
      <artifactId>eventbus-api</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>africa.civitas.egen</groupId>
      <artifactId>eventbus-kafka-adapter</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-arc</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-hibernate-orm-panache</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-jdbc-postgresql</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-flyway</artifactId>
    </dependency>

    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-junit5</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-api</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-engine</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!--
        Seul module du Kernel dont le but "build" est actif : c'est lui qui produit
        l'artefact Quarkus reellement executable (java -jar ...-runner.jar). Partout
        ailleurs dans le Kernel, seuls generate-code/generate-code-tests sont lies
        (voir leurs pom.xml respectifs) — pas de binaire executable attendu d'un
        systeme isole.
      -->
      <plugin>
        <groupId>io.quarkus</groupId>
        <artifactId>quarkus-maven-plugin</artifactId>
        <extensions>true</extensions>
        <executions>
          <execution>
            <goals>
              <goal>build</goal>
              <goal>generate-code</goal>
              <goal>generate-code-tests</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>io.smallrye</groupId>
        <artifactId>jandex-maven-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <systemPropertyVariables>
            <java.util.logging.manager>org.jboss.logmanager.LogManager</java.util.logging.manager>
          </systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>

</project>
