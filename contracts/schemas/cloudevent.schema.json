{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.civitas.africa/egen/v1/cloudevent.schema.json",
  "title": "C5 — Enveloppe CloudEvents 1.0 d'un événement EGEN",
  "type": "object",
  "required": [
    "specversion",
    "id",
    "source",
    "type",
    "subject",
    "time",
    "datacontenttype",
    "data"
  ],
  "properties": {
    "specversion": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "$ref": "common.schema.json#/$defs/eventType"
    },
    "subject": {
      "type": "string",
      "minLength": 1
    },
    "time": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "datacontenttype": {
      "const": "application/json"
    },
    "traceparent": {
      "$ref": "common.schema.json#/$defs/traceparent"
    },
    "data": {
      "type": "object"
    }
  }
}
