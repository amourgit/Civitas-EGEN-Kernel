<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>africa.civitas.egen</groupId>
    <artifactId>egen-kernel</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>egen-bootstrap</artifactId>
  <packaging>jar</packaging>

  <name>EGEN :: Bootstrap</name>
  <description>
    Point d'entree executable : cablage (wiring) de tous les ports vers leurs
    adapters (voir docs/architecture/16-packages-et-stack-technique.md). Seul
    module autorise a connaitre domaine ET adapters simultanement. Porte
    aussi la suite ArchUnit qui verifie mecaniquement en CI les regles de
    dependance du Kernel (voir docs/architecture/17-strategie-de-tests.md,
    niveau 4) : c'est le seul module dont le classpath de test reunit
    egen-domain, egen-application, egen-adapters/* et egen-api a la fois.
  </description>

  <dependencies>
    <dependency>
      <groupId>africa.civitas.egen</groupId>
      <artifactId>egen-domain</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>africa.civitas.egen</groupId>
      <artifactId>egen-application</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>africa.civitas.egen</groupId>
      <artifactId>egen-adapter-nomad</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>africa.civitas.egen</groupId>
      <artifactId>egen-adapter-consul</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>africa.civitas.egen</groupId>
      <artifactId>egen-adapter-postgres-registry</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>africa.civitas.egen</groupId>
      <artifactId>egen-adapter-nats</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>africa.civitas.egen</groupId>
      <artifactId>egen-adapter-vault</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>africa.civitas.egen</groupId>
      <artifactId>egen-adapter-otel</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>africa.civitas.egen</groupId>
      <artifactId>egen-adapter-http-invocation</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>africa.civitas.egen</groupId>
      <artifactId>egen-api</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-arc</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-agroal</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-jdbc-postgresql</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-junit5</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <scope>test</scope>
    </dependency>
    <!--
      Scenario d'acceptation du Moteur de Workflow (docs/architecture/20, partie 2) :
      vrai PostgreSQL via Testcontainers, comme les tests de niveau 3 des adapters.
      Le driver JDBC vient deja de quarkus-jdbc-postgresql.
    -->
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <!--
      Test de niveau 5 (docs/architecture/17) : le VRAI Kernel demarre par Quarkus, pilote par HTTP comme avec
      des curl. L'identite est simulee (@TestSecurity), comme dans les tests de l'API.
    -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-test-security</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.rest-assured</groupId>
      <artifactId>rest-assured</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <properties>
    <!-- Le test de niveau 5 exige Docker et plusieurs minutes : exclu du build par defaut, voir le profil e2e. -->
    <excludedGroups>e2e</excludedGroups>
  </properties>

  <profiles>
    <profile>
      <!-- mvn -Pe2e verify : ne lance QUE les tests etiquetes e2e (docs/architecture/17, niveau 5). -->
      <id>e2e</id>
      <properties>
        <groups>e2e</groups>
        <excludedGroups></excludedGroups>
      </properties>
    </profile>
  </profiles>

  <build>
    <plugins>
      <plugin>
        <groupId>io.quarkus</groupId>
        <artifactId>quarkus-maven-plugin</artifactId>
        <extensions>true</extensions>
        <executions>
          <execution>
            <goals>
              <goal>build</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <!-- Execute les *IT (scenarios d'acceptation avec Testcontainers) a la phase verify. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
      </plugin>
    </plugins>
  </build>

</project>
