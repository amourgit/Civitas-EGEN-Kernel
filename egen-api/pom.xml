<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>africa.civitas.egen</groupId>
    <artifactId>egen-kernel</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>egen-api</artifactId>
  <packaging>jar</packaging>

  <name>EGEN :: API</name>
  <description>
    Adapters PRIMAIRES : controleurs REST (voir
    docs/architecture/13-api-et-contrats.md). DTOs de transport et mapper
    DTO&lt;-&gt;Domain uniquement — aucune entite de domaine n'est jamais serialisee
    directement, aucune fuite de DTO vers le domaine. Depend d'egen-application
    (les ports primaires qu'il appelle) et d'egen-domain (pour construire les
    objets de domaine dans le mapper) ; ne connait jamais un adapter concret
    (egen-adapters/*) — voir docs/architecture/02-principes-fondamentaux.md.
    Seul module avec egen-bootstrap a dependre de Quarkus.
  </description>

  <dependencies>
    <dependency>
      <groupId>africa.civitas.egen</groupId>
      <artifactId>egen-application</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>africa.civitas.egen</groupId>
      <artifactId>egen-domain</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-rest-jackson</artifactId>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.dataformat</groupId>
      <artifactId>jackson-dataformat-yaml</artifactId>
    </dependency>
    <dependency>
      <!-- Validation du jeton JWT porteur (humains via l'IdP de
           l'entreprise, machine-a-machine via client-credentials) ET
           acces type aux claims (JsonWebToken, @Claim), en une seule
           extension MicroProfile JWT standard — voir
           docs/architecture/14-securite.md, "Authentification". Choix
           delibere face a quarkus-oidc : combiner oidc+smallrye-jwt est un
           second mecanisme d'authentification a part entiere que ce
           Kernel n'a pas besoin d'ajouter, alors que smallrye-jwt seul
           couvre deja validation + roles + claims personnalises. -->
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-smallrye-jwt</artifactId>
    </dependency>
    <dependency>
      <groupId>africa.civitas.egen</groupId>
      <artifactId>egen-test-kit</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-junit5</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <!-- @TestSecurity — stub d'identite pour les tests HTTP maintenant que
           ServiceResource exige un appelant authentifie (voir
           docs/architecture/14-securite.md). -->
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-test-security</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.rest-assured</groupId>
      <artifactId>rest-assured</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

</project>
