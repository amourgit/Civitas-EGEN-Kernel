        "retry": {
          "maxAttempts": 1,
          "backoff": "fixed",
          "baseDelayMillis": 200
        },
        "circuitBreaker": {
          "failureThreshold": 3,
          "openDurationMillis": 1000
        }
      },
      "steps": [
        {
          "call": [
            "200"
          ],
          "expect": {
            "result": "status:200",
            "attemptsMade": 1,
            "sleepsMillis": [],
            "breaker": "CLOSED"
          }
        },
        {
          "call": [
            "204"
          ],
          "expect": {
