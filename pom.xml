<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>africa.civitas.egen</groupId>
  <artifactId>egen-kernel</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>EGEN Kernel</name>
  <description>
    Control/Composition Plane hexagonal developpe par CIVITAS Africa. EGEN compose
    des moteurs specialises deja eprouves (Nomad, Consul, Kafka/NATS) plutot que de
    les reimplementer — voir docs/architecture/README.md pour la reference complete.
    Ce reacteur ne construit QUE le Kernel : aucun service metier n'y vit jamais
    comme module ou dependance Maven.
  </description>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    <java.version>21</java.version>
    <maven.compiler.release>21</maven.compiler.release>

    <!-- Versions des plugins Maven, epinglees pour la reproductibilite du build -->
    <maven-compiler-plugin.version>3.13.0</maven-compiler-plugin.version>
    <maven-surefire-plugin.version>3.2.5</maven-surefire-plugin.version>
    <!--
      maven-failsafe-plugin : execute les tests d'adapters de niveau 3 (voir
      docs/architecture/17-strategie-de-tests.md) — suffixe *IT.java, lies a
      Testcontainers, plus lents que les tests unitaires *Test.java geres par
      surefire. Lie a la phase verify, donc deja couvert par le "mvn verify"
      unique de la CI, sans etape separee a ajouter au pipeline.
    -->
    <maven-failsafe-plugin.version>3.2.5</maven-failsafe-plugin.version>
    <maven-jar-plugin.version>3.4.1</maven-jar-plugin.version>
    <maven-enforcer-plugin.version>3.5.0</maven-enforcer-plugin.version>

    <!--
      SmallRye Jandex (Apache 2.0) — necessaire pour que tout module publie un index
      Jandex dans son JAR (META-INF/jandex.idx), sans quoi Quarkus ne decouvre jamais
      ses beans CDI quand ce module est consomme comme dependance par egen-bootstrap.
    -->
    <jandex-maven-plugin.version>3.6.0</jandex-maven-plugin.version>

    <!--
      Quarkus — runtime des SEULS modules primaires/de cablage (egen-api,
      egen-bootstrap ; voir docs/architecture/16-packages-et-stack-technique.md).
      egen-domain et egen-application n'en dependent JAMAIS. Version epinglee sur
      la ligne LTS 3.33 (supportee jusqu'en mars 2027) plutot que la derniere
      version non-LTS, par choix de stabilite long terme. A remonter vers le
      dernier correctif 3.33.x publie au moment de l'implementation reelle (non
      verifiable depuis ce sandbox, Maven Central injoignable — confirme par la CI
      a chaque build).

      Le BOM Quarkus gere lui-meme une version coherente de JUnit 5 (jupiter +
      platform launcher) pour tout le reacteur. Ne JAMAIS importer un junit-bom
      separe en parallele : les deux BOM se disputeraient la gestion de version des
      memes artefacts JUnit, avec un risque reel de version splittee entre
      org.junit.jupiter.* et org.junit.platform:junit-platform-launcher.
    -->
    <quarkus.platform.group-id>io.quarkus.platform</quarkus.platform.group-id>
    <quarkus.platform.artifact-id>quarkus-bom</quarkus.platform.artifact-id>
    <quarkus.platform.version>3.33.2</quarkus.platform.version>

    <!--
      Testcontainers (MIT) — utilise par les modules egen-adapters/* pour leurs
      tests de niveau 3 (voir docs/architecture/17-strategie-de-tests.md) : chaque
      adapter demarre le moteur reel concerne (Nomad, Consul, NATS...) dans un
      conteneur ephemere. Version non verifiable depuis ce sandbox — a confirmer
      par la CI.
    -->
    <testcontainers.version>1.20.4</testcontainers.version>

    <!--
      ArchUnit (Apache 2.0) — transforme les regles de dependance de
      docs/architecture/02-principes-fondamentaux.md et 16-packages-et-stack-technique.md
      en tests qui echouent la CI (voir egen-bootstrap, seul module avec visibilite
      sur domaine + application + adapters + api). Version non verifiable depuis ce
      sandbox — a confirmer par la CI.
    -->
    <archunit.version>1.3.0</archunit.version>
  </properties>

  <modules>
    <module>egen-domain</module>
    <module>egen-application</module>
    <module>egen-adapters</module>
    <module>egen-contracts</module>
    <module>egen-api</module>
    <module>egen-bootstrap</module>
    <module>egen-test-kit</module>
  </modules>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>${quarkus.platform.group-id}</groupId>
        <artifactId>${quarkus.platform.artifact-id}</artifactId>
        <version>${quarkus.platform.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.testcontainers</groupId>
        <artifactId>testcontainers-bom</artifactId>
        <version>${testcontainers.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>com.tngtech.archunit</groupId>
        <artifactId>archunit-junit5</artifactId>
        <version>${archunit.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>${maven-compiler-plugin.version}</version>
          <configuration>
            <release>${maven.compiler.release}</release>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>${maven-surefire-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-jar-plugin</artifactId>
          <version>${maven-jar-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-failsafe-plugin</artifactId>
          <version>${maven-failsafe-plugin.version}</version>
          <executions>
            <execution>
              <goals>
                <goal>integration-test</goal>
                <goal>verify</goal>
              </goals>
            </execution>
          </executions>
        </plugin>
        <!--
          maven-enforcer-plugin : impose au niveau du build certaines regles du DAG
          de dependances du Kernel (ex. bannedDependencies dans egen-adapters/*
          pour interdire qu'un adapter depende d'un autre). La version est fixee
          ici (pluginManagement) ; chaque module active l'execution dont il a
          besoin dans son propre <build><plugins>.
        -->
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-enforcer-plugin</artifactId>
          <version>${maven-enforcer-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>io.quarkus</groupId>
          <artifactId>quarkus-maven-plugin</artifactId>
          <version>${quarkus.platform.version}</version>
        </plugin>
        <plugin>
          <groupId>io.smallrye</groupId>
          <artifactId>jandex-maven-plugin</artifactId>
          <version>${jandex-maven-plugin.version}</version>
          <executions>
            <execution>
              <id>make-index</id>
              <goals>
                <goal>jandex</goal>
              </goals>
            </execution>
          </executions>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>

</project>
