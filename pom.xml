<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>africa.civitas.egen</groupId>
  <artifactId>egen-platform</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>EGEN Platform</name>
  <description>
    EGEN Kernel — la plateforme technique neutre developpee par CIVITAS Africa qui
    monte, enregistre, connecte, orchestre et exploite des services independants
    (voir docs/architecture/charte-v3.md pour ce que "neutre" signifie concretement
    dans le code, pas seulement dans l'intention). Ce depot racine (reacteur Maven)
    n'heberge que le Kernel lui-meme (egen-kernel/) : aucun service ni module
    metier n'y vit jamais comme dependance Maven — voir README.md pour le detail
    des deux modes d'extension de l'ecosysteme.
  </description>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    <java.version>21</java.version>
    <maven.compiler.release>21</maven.compiler.release>

    <!-- Versions des plugins Maven, epinglees pour la reproductibilite du build -->
    <maven-compiler-plugin.version>3.13.0</maven-compiler-plugin.version>
    <maven-surefire-plugin.version>3.2.5</maven-surefire-plugin.version>
    <maven-jar-plugin.version>3.4.1</maven-jar-plugin.version>
    <maven-enforcer-plugin.version>3.5.0</maven-enforcer-plugin.version>
    <!--
      SmallRye Jandex (Apache 2.0) — pas l'ancien org.jboss.jandex:jandex-maven-plugin,
      qui est sous GPL v3 et a ete remplace par ce projet (memes mainteneurs, nouvelles
      coordonnees). Necessaire pour que tout module publie un index Jandex dans
      son JAR (META-INF/jandex.idx) — sans quoi Quarkus ne decouvre jamais ses beans
      CDI quand ce module est consomme comme dependance de test par un autre module.
    -->
    <jandex-maven-plugin.version>3.6.0</jandex-maven-plugin.version>

    <!--
      Testcontainers (MIT) — utilise directement par kernel-test-support
      (PostgresTestResource). Non gere par le BOM Quarkus pour l'artefact
      org.testcontainers:postgresql (contrairement a la plupart des dependances de
      ce depot) ; import du BOM Testcontainers lui-meme ci-dessous plutot que de
      fixer une version par artefact individuel. Version non verifiable depuis ce
      sandbox (Maven Central injoignable) — a confirmer par la CI.
    -->
    <testcontainers.version>1.20.4</testcontainers.version>

    <!--
      Quarkus — runtime du Kernel (voir la decision d'architecture posee dans nos
      echanges : Quarkus heberge le Kernel, jamais l'inverse ; les contrats restent en
      Jakarta EE). Version epinglee sur la ligne LTS 3.33 (supportee jusqu'en mars
      2027) plutot que la derniere version non-LTS, par choix de stabilite long terme.
      A remonter vers le dernier correctif 3.33.x publie au moment de l'implementation
      reelle (non verifiable depuis ce sandbox, verifie par la CI a chaque build).

      Le BOM Quarkus gere lui-meme une version coherente de JUnit 5 (jupiter + platform
      launcher) pour tout le reacteur — y compris kernel-sdk et les modules -api qui ne
      dependent d'aucun autre artefact Quarkus. Ne JAMAIS importer un junit-bom separe
      en parallele : les deux BOM se disputeraient alors la gestion de version des
      memes artefacts JUnit, avec un risque reel de version splittee entre
      org.junit.jupiter.* (gere par le premier BOM importe) et
      org.junit.platform:junit-platform-launcher (tire transitivement par
      quarkus-junit5) — exactement le bug qui a fait echouer le premier essai de ce
      module (NoSuchMethodError sur LauncherSession.getStore()).
    -->
    <quarkus.platform.group-id>io.quarkus.platform</quarkus.platform.group-id>
    <quarkus.platform.artifact-id>quarkus-bom</quarkus.platform.artifact-id>
    <quarkus.platform.version>3.33.2</quarkus.platform.version>

    <!--
      PF4J (Apache 2.0) — le mecanisme de plugins choisi pour EGEN en remplacement
      d'OSGi (decision d'architecture posee des le debut). Utilise uniquement par
      kernel-plugin-engine/Pf4jPluginLoader, isole derriere l'interface PluginLoader.
      Version non verifiable depuis ce sandbox (Maven Central injoignable) — a
      confirmer par la CI, qui y a acces reel, et a corriger si necessaire.
    -->
    <pf4j.version>3.12.0</pf4j.version>
  </properties>

  <modules>
    <module>egen-kernel</module>
  </modules>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>${quarkus.platform.group-id}</groupId>
        <artifactId>${quarkus.platform.artifact-id}</artifactId>
        <version>${quarkus.platform.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.pf4j</groupId>
        <artifactId>pf4j</artifactId>
        <version>${pf4j.version}</version>
      </dependency>
      <dependency>
        <groupId>org.testcontainers</groupId>
        <artifactId>testcontainers-bom</artifactId>
        <version>${testcontainers.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>${maven-compiler-plugin.version}</version>
          <configuration>
            <release>${maven.compiler.release}</release>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>${maven-surefire-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-jar-plugin</artifactId>
          <version>${maven-jar-plugin.version}</version>
        </plugin>
        <!--
          maven-enforcer-plugin : impose au niveau du build le DAG de dependances du Kernel.
          La version est fixee ici (pluginManagement) ; l'execution reelle de la regle est
          declaree plus bas, dans <build><plugins> (pas seulement pluginManagement), pour
          qu'elle soit heritee et executee dans CHAQUE module du reacteur — voir cette
          execution pour le detail de la regle.
        -->
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-enforcer-plugin</artifactId>
          <version>${maven-enforcer-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>io.quarkus</groupId>
          <artifactId>quarkus-maven-plugin</artifactId>
          <version>${quarkus.platform.version}</version>
        </plugin>
        <plugin>
          <groupId>io.smallrye</groupId>
          <artifactId>jandex-maven-plugin</artifactId>
          <version>${jandex-maven-plugin.version}</version>
          <executions>
            <execution>
              <id>make-index</id>
              <goals>
                <goal>jandex</goal>
              </goals>
            </execution>
          </executions>
        </plugin>
      </plugins>
    </pluginManagement>

  </build>

</project>
