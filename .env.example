# Variables d'environnement pour lancer egen-bootstrap contre les services de
# docker-compose.yml (perimetre Phase 1-2 — voir
# docs/architecture/19-feuille-de-route.md). Copier vers .env et adapter.

# Convention reprise du CLI Nomad officiel (voir
# docs/architecture/16-packages-et-stack-technique.md, egen-bootstrap
# application.properties).
NOMAD_ADDR=http://localhost:4646

# Token ACL Nomad de l'adapter, scope minimal (submit-job, read-job,
# dispatch-job) — jamais le token root de bootstrap. Absent par defaut : le
# Nomad de docker-compose.yml tourne en mode dev sans ACL. Voir
# docs/architecture/14-securite.md.
NOMAD_TOKEN=

# Convention reprise du CLI Consul officiel.
CONSUL_HTTP_ADDR=http://localhost:8500

# Token ACL Consul de l'adapter, write scope aux prefixes de service geres
# par EGEN — jamais un token root. Absent par defaut : le Consul de
# docker-compose.yml tourne en mode dev sans ACL.
CONSUL_HTTP_TOKEN=

# Registry EGEN (PostgreSQL) — doit correspondre aux identifiants du service
# "postgres" de docker-compose.yml.
EGEN_REGISTRY_DB_URL=jdbc:postgresql://localhost:5432/egen_registry
EGEN_REGISTRY_DB_USER=egen
EGEN_REGISTRY_DB_PASSWORD=egen
