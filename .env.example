# Exemple de variables d'environnement pour lancer kernel-bootstrap en dehors du
# mode dev de Quarkus (qui provisionne lui-meme Postgres via Dev Services) — par
# exemple contre les services de docker-compose.yml. Copier vers .env et adapter.

QUARKUS_DATASOURCE_JDBC_URL=jdbc:postgresql://localhost:5432/egen
QUARKUS_DATASOURCE_USERNAME=egen
QUARKUS_DATASOURCE_PASSWORD=egen

# Contexte racine pour la premiere passe de chargement de plugins au demarrage (voir
# KernelBootConfig) — un UUID quelconque en local, tant qu'aucune Activation reelle
# n'est encore attendue.
EGEN_KERNEL_CONTEXTE_RACINE=00000000-0000-0000-0000-000000000001

# Kafka (eventbus-kafka-adapter) — depuis le 11 septembre 2026, EventBus est un
# vrai bean CDI (KernelBootConfig.eventBus()), mais ce producteur retourne par
# defaut InMemoryEventBus, jamais KafkaEventBusAdapter : passer a Kafka exige de
# changer ce seul producteur, jamais ailleurs dans le Kernel. Valeurs fournies ici
# par anticipation de ce jour-la.
EGEN_EVENTBUS_KAFKA_BOOTSTRAP_SERVERS=localhost:9094
EGEN_EVENTBUS_KAFKA_CONSUMER_GROUP=egen-kernel

# Keycloak (identity-provider-keycloak) — non plus cablee en configuration
# specifique dans cette livraison ; identity-provider-keycloak porte a ce jour
# uniquement le modele de donnees et la logique applicative, pas encore la
# resolution OIDC/JWT reelle (voir sa description dans egen-modules/system/identity).
