# Exemple de variables d'environnement pour lancer kernel-bootstrap en dehors du
# mode dev de Quarkus (qui provisionne lui-meme Postgres via Dev Services) — par
# exemple contre les services de docker-compose.yml. Copier vers .env et adapter.

QUARKUS_DATASOURCE_JDBC_URL=jdbc:postgresql://localhost:5432/egen
QUARKUS_DATASOURCE_USERNAME=egen
QUARKUS_DATASOURCE_PASSWORD=egen

# Kafka (eventbus-kafka-adapter) — EventBus est un vrai bean CDI
# (KernelBootConfig.eventBus()), mais ce producteur retourne par defaut
# InMemoryEventBus, jamais KafkaEventBusAdapter : passer a Kafka exige de changer ce
# seul producteur, jamais ailleurs dans le Kernel. Valeurs fournies ici par
# anticipation de ce jour-la.
EGEN_EVENTBUS_KAFKA_BOOTSTRAP_SERVERS=localhost:9094
EGEN_EVENTBUS_KAFKA_CONSUMER_GROUP=egen-kernel
