{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://egen.civitas.africa/schema/service-manifest.schema.json",
  "title": "EGEN Service Manifest",
  "description": "Contrat technique declare par un service autonome aupres du Kernel EGEN. Voir docs/architecture/06-service-manifest.md. Champs actuellement valides par le domaine (egen-domain) — network/health/dependencies/events/configuration/lifecycle rejoignent ce schema aux phases qui les introduisent (docs/architecture/19-feuille-de-route.md), jamais par anticipation.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "runtime", "deployment"],
  "properties": {
    "apiVersion": {
      "type": "string",
      "const": "egen.civitas.africa/v1"
    },
    "kind": {
      "type": "string",
      "const": "ServiceManifest"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$",
          "description": "Devient le ServiceId — convention DNS/Kubernetes, voir domain.model.ServiceId."
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(-[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$",
          "description": "SemVer — voir domain.model.ServiceVersion."
        },
        "team": { "type": "string" },
        "labels": { "type": "object", "additionalProperties": { "type": "string" } },
        "annotations": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "artifact"],
      "properties": {
        "type": { "type": "string", "enum": ["container", "binary", "external", "vm"] },
        "artifact": { "type": "string", "minLength": 1 },
        "language": { "type": "string", "description": "Informatif uniquement — jamais interprete par EGEN." }
      }
    },
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter", "image", "resources", "replicas"],
      "properties": {
        "adapter": { "type": "string", "minLength": 1, "description": "Doit correspondre a un Deployment Adapter enregistre dans le Kernel." },
        "image": { "type": "string", "minLength": 1 },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cpu", "memory"],
          "properties": {
            "cpu": { "type": "string", "minLength": 1 },
            "memory": { "type": "string", "minLength": 1 }
          }
        },
        "replicas": {
          "type": "object",
          "additionalProperties": false,
          "required": ["min", "max"],
          "properties": {
            "min": { "type": "integer", "minimum": 0 },
            "max": { "type": "integer", "minimum": 0 }
          }
        }
      }
    }
  }
}
