{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://egen.civitas.africa/schema/service-manifest.schema.json",
  "title": "EGEN Service Manifest",
  "description": "Contrat technique declare par un service autonome aupres du Kernel EGEN. Voir docs/architecture/06-service-manifest.md. Champs actuellement valides par le domaine (egen-domain) — network/health/dependencies/events/configuration/lifecycle rejoignent ce schema aux phases qui les introduisent (docs/architecture/19-feuille-de-route.md), jamais par anticipation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "runtime",
    "deployment",
    "health"
  ],
  "properties": {
    "apiVersion": {
      "type": "string",
      "const": "egen.civitas.africa/v1"
    },
    "kind": {
      "type": "string",
      "const": "ServiceManifest"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$",
          "description": "Devient le ServiceId — convention DNS/Kubernetes, voir domain.model.ServiceId."
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(-[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$",
          "description": "SemVer — voir domain.model.ServiceVersion."
        },
        "team": {
          "type": "string"
        },
        "labels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "artifact"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "container",
            "binary",
            "external",
            "vm"
          ]
        },
        "artifact": {
          "type": "string",
          "minLength": 1
        },
        "language": {
          "type": "string",
          "description": "Informatif uniquement — jamais interprete par EGEN."
        }
      }
    },
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adapter",
        "image",
        "resources",
        "replicas"
      ],
      "properties": {
        "adapter": {
          "type": "string",
          "minLength": 1,
          "description": "Doit correspondre a un Deployment Adapter enregistre dans le Kernel."
        },
        "image": {
          "type": "string",
          "minLength": 1
        },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "cpu",
            "memory"
          ],
          "properties": {
            "cpu": {
              "type": "string",
              "minLength": 1
            },
            "memory": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "replicas": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "min",
            "max"
          ],
          "properties": {
            "min": {
              "type": "integer",
              "minimum": 0
            },
            "max": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "health": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "http"
      ],
      "properties": {
        "http": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "endpoint",
            "interval",
            "timeout"
          ],
          "properties": {
            "endpoint": {
              "type": "string",
              "minLength": 1
            },
            "interval": {
              "type": "string",
              "pattern": "^[0-9]+s$"
            },
            "timeout": {
              "type": "string",
              "pattern": "^[0-9]+s$"
            },
            "failuresBeforeUnhealthy": {
              "type": "integer",
              "minimum": 1,
              "default": 3
            }
          }
        }
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "shutdown": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "gracePeriod": {
              "type": "string",
              "pattern": "^[0-9]+s$"
            }
          }
        }
      }
    },
    "resiliency": {
      "type": "object",
      "additionalProperties": false,
      "description": "Politique demandee a tous les appelants de ce service (docs/architecture/06 et 12). Tout champ omis prend sa valeur par defaut.",
      "properties": {
        "timeout": {
          "type": "string",
          "pattern": "^[0-9]+(ms|s|m|h)$",
          "description": "Par tentative ; defaut 30s."
        },
        "retry": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "maxAttempts": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10,
              "description": "Tentatives totales, premiere incluse ; defaut 1."
            },
            "backoff": {
              "enum": [
                "fixed",
                "exponential"
              ],
              "description": "Defaut fixed."
            },
            "baseDelay": {
              "type": "string",
              "pattern": "^[0-9]+(ms|s|m|h)$",
              "description": "Defaut 200ms."
            }
          }
        },
        "circuitBreaker": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "failureThreshold": {
              "type": "integer",
              "minimum": 1,
              "description": "Echecs consecutifs ; defaut 5."
            },
            "openDuration": {
              "type": "string",
              "pattern": "^[0-9]+(ms|s|m|h)$",
              "description": "Defaut 30s."
            }
          }
        }
      }
    },
    "dependencies": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "services": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "versionConstraint": {
                "type": "string"
              },
              "required": {
                "type": "boolean",
                "default": true
              }
            }
          }
        },
        "resources": {
          "type": "array",
          "description": "Ressources externes nommees (docs/architecture/06) : referencees, JAMAIS gerees en V1.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "type"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
              },
              "type": {
                "type": "string",
                "minLength": 1
              },
              "params": {
                "type": "object",
                "additionalProperties": {
                  "type": [
                    "string",
                    "number",
                    "boolean"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "events": {
      "type": "object",
      "additionalProperties": false,
      "description": "Evenements publies et consommes (docs/architecture/06). Le Kernel n'en lit jamais le contenu.",
      "properties": {
        "publishes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,254}$",
                "description": "Devient un sujet de messagerie : ni espace ni caractere generique."
              },
              "schemaRef": {
                "type": "string"
              }
            }
          }
        },
        "consumes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,254}$",
                "description": "Devient un sujet de messagerie : ni espace ni caractere generique."
              },
              "subscriptionGroup": {
                "type": "string"
              },
              "deadLetter": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "strategy"
                ],
                "properties": {
                  "maxRetries": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "strategy": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        }
      }
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "description": "Configuration SANS valeurs : EGEN ne stocke jamais un secret, uniquement une reference.",
      "properties": {
        "required": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "key"
            ],
            "properties": {
              "key": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_.-]{0,127}$"
              },
              "type": {
                "enum": [
                  "string",
                  "boolean",
                  "integer",
                  "number"
                ],
                "default": "string"
              },
              "default": {
                "type": [
                  "string",
                  "boolean",
                  "number"
                ]
              }
            }
          }
        },
        "secretsRefs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "key",
              "provider",
              "path"
            ],
            "properties": {
              "key": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_.-]{0,127}$"
              },
              "provider": {
                "type": "string",
                "minLength": 1
              },
              "path": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "interfaces": {
      "type": "array",
      "description": "Interfaces annoncees a la couche agentique (docs/architecture/21, 21.3). OPAQUE pour le Kernel : seule la forme est verifiee, jamais les valeurs.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "ref"
        ],
        "properties": {
          "type": {
            "type": "string",
            "minLength": 1,
            "description": "mcp, openapi, ... (liste ouverte)."
          },
          "ref": {
            "type": "string",
            "minLength": 1
          },
          "riskDefault": {
            "type": "string",
            "description": "read, write, sensitive, ... (liste ouverte)."
          }
        }
      }
    }
  }
}
