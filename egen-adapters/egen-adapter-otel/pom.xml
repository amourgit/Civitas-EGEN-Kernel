<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>africa.civitas.egen</groupId>
    <artifactId>egen-adapters</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>egen-adapter-otel</artifactId>
  <packaging>jar</packaging>

  <name>EGEN :: Adapters :: OpenTelemetry</name>
  <description>
    Implementation du ObservabilityPort (egen-application) via le SDK
    OpenTelemetry reel, export OTLP (voir
    docs/architecture/07-ports-et-adapters.md, "Observability Port" et
    docs/architecture/15-observabilite.md). Seul module de ce reacteur a
    dependre du SDK OpenTelemetry — aucun autre adapter n'en depend
    directement (chaque adapter reste focalise sur SA technologie propre ;
    c'est la boucle de reconciliation, via ObservabilityPort, qui centralise
    la telemetrie — voir egen-application/reconciliation/ReconciliationEngine).
  </description>

  <dependencies>
    <dependency>
      <groupId>africa.civitas.egen</groupId>
      <artifactId>egen-application</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.opentelemetry</groupId>
      <artifactId>opentelemetry-api</artifactId>
    </dependency>
    <dependency>
      <groupId>io.opentelemetry</groupId>
      <artifactId>opentelemetry-sdk</artifactId>
    </dependency>
    <dependency>
      <groupId>io.opentelemetry</groupId>
      <artifactId>opentelemetry-exporter-otlp</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.opentelemetry</groupId>
      <artifactId>opentelemetry-sdk-testing</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>ban-cross-adapter-and-upward-dependencies</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <bannedDependencies>
                  <excludes>
                    <exclude>africa.civitas.egen:egen-adapter-nomad</exclude>
                    <exclude>africa.civitas.egen:egen-adapter-consul</exclude>
                    <exclude>africa.civitas.egen:egen-adapter-postgres-registry</exclude>
                    <exclude>africa.civitas.egen:egen-adapter-nats</exclude>
                    <exclude>africa.civitas.egen:egen-adapter-vault</exclude>
                    <exclude>africa.civitas.egen:egen-api</exclude>
                    <exclude>africa.civitas.egen:egen-bootstrap</exclude>
                  </excludes>
                </bannedDependencies>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

</project>
