<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>africa.civitas.egen</groupId>
    <artifactId>egen-kernel</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>egen-sidecar</artifactId>
  <packaging>jar</packaging>

  <name>EGEN :: Sidecar de reference</name>
  <description>
    Sidecar de reference de la Communication Fabric (voir docs/architecture/12-communication-fabric.md) :
    un seul processus, ecoute sur 127.0.0.1 uniquement, construit sur egen-sdk-java — il n'a donc AUCUNE
    logique de resilience propre, il l'herite. Seule dependance autorisee : egen-sdk-java (et JUnit en
    test), imposee ci-dessous par maven-enforcer-plugin.
  </description>

  <dependencies>
    <dependency>
      <groupId>africa.civitas.egen</groupId>
      <artifactId>egen-sdk-java</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <configuration>
          <archive>
            <manifest>
              <mainClass>africa.civitas.egen.sidecar.SidecarMain</mainClass>
            </manifest>
          </archive>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>sdk-only-no-kernel-dependency</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <bannedDependencies>
                  <excludes>
                    <exclude>*</exclude>
                  </excludes>
                  <includes>
                    <include>africa.civitas.egen:egen-sdk-java</include>
                    <include>*:*:*:*:test</include>
                  </includes>
                  <message>egen-sidecar ne depend que d'egen-sdk-java (voir docs/architecture/12).</message>
                </bannedDependencies>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

</project>
